<group name="local,syscheck,">

  
  <rule id="100200" level="0">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^/var/lib/(dpkg|apt|rpm|dnf|yum)</field>
    <description>FIM: Suppressed - package manager metadata change</description>
  </rule>

  
  <rule id="100201" level="0">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^/var/log/.*\.(gz|[0-9]+|old|bak)$</field>
    <description>FIM: Suppressed - log rotation artifact</description>
  </rule>

  
  <rule id="100202" level="0">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^/(tmp|var/tmp|var/cache)/</field>
    <description>FIM: Suppressed - temporary/cache file change</description>
  </rule>

  <rule id="100203" level="0">
    <if_sid>19004,19005,19007,19008,19009,19012,19013</if_sid>
    <description>SCA: Suppressed - startup CIS benchmark flood</description>
  </rule>

  <rule id="100204" level="0">
    <if_sid>80705</if_sid>
    <description>Auditd: Suppressed - startup rule reload</description>
  </rule>

  <rule id="100205" level="0">
    <if_sid>92900</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)\\Windows Defender\\Platform\\.*\\MsMpEng\.exe$</field>
    <description>Windows: Suppressed - Defender LSASS scan</description>
  </rule>

  <rule id="100206" level="0">
    <if_sid>61634,61638</if_sid>
    <description>Windows: Suppressed - noisy taskhost/dllhost Sysmon rule</description>
  </rule>

</group>
