<group name="ccdc,linux,">

  
  <rule id="102001" level="10">
    <if_group>syslog|sudo</if_group>
    <match type="pcre2">(?i)(useradd|NOPASSWD|visudo|usermod\s+.*-aG\s+(sudo|wheel|admin))</match>
    <description>CCDC Linux: Privilege escalation or user/sudoers modification detected</description>
    <mitre>
      <id>T1548.003</id>
      <id>T1136.001</id>
    </mitre>
    <group>privilege_escalation,ccdc_high,</group>
  </rule>

  
  <rule id="102002" level="12" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>CCDC Linux: SSH brute force attack from $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>sshd,bruteforce,ccdc_high,</group>
  </rule>

  
  <rule id="102003" level="12">
    <if_sid>5715</if_sid>
    <match type="pcre2">Accepted\s+.*\s+for\s+root\b</match>
    <description>CCDC Linux: Successful root login via SSH from $(srcip)</description>
    <mitre>
      <id>T1078.003</id>
      <id>T1021.004</id>
    </mitre>
    <group>sshd,authentication_success,ccdc_high,</group>
  </rule>

  
  <rule id="102004" level="10">
    <if_group>syslog</if_group>
    <match type="pcre2">Successful su for root</match>
    <description>CCDC Linux: Interactive su to root detected</description>
    <mitre>
      <id>T1548</id>
    </mitre>
    <group>privilege_escalation,ccdc_high,</group>
  </rule>

  
  <rule id="102005" level="7">
    <if_group>syslog</if_group>
    <match type="pcre2">\b(apt|apt-get|yum|dnf|dpkg|rpm)\b.*(install|remove|purge|erase)</match>
    <description>CCDC Linux: Package management activity detected</description>
    <group>package_management,ccdc_low,</group>
  </rule>

  
  <rule id="102006" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/etc/(passwd|shadow|group|sudoers|sudoers\.d/|ssh/sshd_config|cron)|/root/\.ssh/|/etc/systemd/system/)</field>
    <description>CCDC Linux FIM: Critical system/auth/persistence file modified ($(syscheck.path))</description>
    <mitre>
      <id>T1098</id>
      <id>T1543.002</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  
  <rule id="102007" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/var/www/|/usr/share/(roundcube|nginx|httpd)/|/opt/.*/webapps/)</field>
    <description>CCDC Linux FIM: Webroot file modified/added ($(syscheck.path))</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>syscheck,webshell,ccdc_high,</group>
  </rule>

  <rule id="102008" level="12">
    <if_group>audit</if_group>
    <field name="audit.exe" type="pcre2">^(/tmp/|/dev/shm/|/var/tmp/|memfd:)|\(deleted\)$</field>
    <description>CCDC Linux Audit: Execution from temp/shm or deleted/memfd binary ($(audit.exe))</description>
    <mitre>
      <id>T1059</id>
      <id>T1620</id>
    </mitre>
    <group>audit,execution,defense_evasion,ccdc_high,</group>
  </rule>

  <rule id="102009" level="11">
    <if_group>audit|syslog</if_group>
    <match type="pcre2">(?i)(/dev/tcp/|bash\s+-i|nc\s+-e|ncat\s+-e|curl.*\|\s*(ba)?sh|wget.*\|\s*(ba)?sh)</match>
    <description>CCDC Linux: Reverse shell or piped payload execution detected</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1105</id>
    </mitre>
    <group>execution,c2,ccdc_high,</group>
  </rule>

  <rule id="102010" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/etc/ld\.so\.preload|/etc/pam\.d/|/etc/profile\.d/|/home/.*/\.ssh/authorized_keys|/root/\.ssh/authorized_keys)</field>
    <description>CCDC Linux FIM: Persistence file modified ($(syscheck.path))</description>
    <mitre>
      <id>T1574.006</id>
      <id>T1556.003</id>
      <id>T1098.004</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102011" level="11">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^/etc/(postfix|dovecot|exim4|mysql|postgresql)/</field>
    <description>CCDC Linux FIM: Mail or database configuration modified ($(syscheck.path))</description>
    <mitre>
      <id>T1505</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102012" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^(shadow_read|suid_priv|ccdc_exec)$</field>
    <field name="audit.exe" type="pcre2" negate="yes">(unix_chkpwd|gdm-session-worker|polkit-agent-helper-1|chage|passwd)$</field>
    <match type="pcre2">(chmod\s+[u\+]*s|setcap|find\s+.*-perm\s+-4000|/etc/shadow)</match>
    <description>CCDC Linux Audit: SUID/capability abuse or /etc/shadow access</description>
    <mitre>
      <id>T1548.001</id>
      <id>T1003.008</id>
    </mitre>
    <group>audit,privilege_escalation,credential_access,ccdc_high,</group>
  </rule>

  <rule id="102013" level="7">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">\b(whoami|uname\s+-a|cat\s+/etc/passwd|ss\s+-|netstat\s+-)\b</match>
    <description>CCDC Linux Audit: Host discovery command executed</description>
    <mitre>
      <id>T1082</id>
      <id>T1033</id>
    </mitre>
    <group>audit,discovery,ccdc_low,</group>
  </rule>

  <rule id="102014" level="10">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">\b(mysqldump|pg_dump|7z\s+a|tar\s+-c)\b</match>
    <description>CCDC Linux Audit: Database dump or archive staging executed</description>
    <mitre>
      <id>T1560</id>
      <id>T1005</id>
    </mitre>
    <group>audit,collection,ccdc_medium,</group>
  </rule>

  <rule id="102015" level="13">
    <if_group>audit</if_group>
    <field name="audit.ppid_comm" type="pcre2">^(apache2|httpd|nginx|php-fpm)$</field>
    <field name="audit.comm" type="pcre2">^(sh|bash|dash|python|python3|perl|nc)$</field>
    <description>CCDC Linux Audit: Web server spawned shell ($(audit.ppid_comm) -> $(audit.comm))</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>audit,webshell,ccdc_high,</group>
  </rule>

  <rule id="102016" level="10">
    <if_group>web|accesslog</if_group>
    <match type="pcre2">(?i)(union\s+select|\.\./\.\./|cmd=|eval\(|base64_decode)</match>
    <description>CCDC Linux Web: Possible SQLi, path traversal, or webshell request</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,ccdc_high,</group>
  </rule>

</group>
