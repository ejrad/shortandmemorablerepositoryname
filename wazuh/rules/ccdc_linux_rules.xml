<group name="ccdc,linux,">

  <rule id="102001" level="10">
    <if_group>syslog|sudo|audit</if_group>
    <match type="pcre2">(?i)(useradd|NOPASSWD|visudo|usermod\b.*-aG\b.*(sudo|wheel|admin))</match>
    <description>User/sudoers privesc</description>
    <mitre>
      <id>T1548.003</id>
      <id>T1136.001</id>
    </mitre>
    <group>privilege_escalation,ccdc_high,</group>
  </rule>

  <rule id="102002" level="12" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>SSH brute force: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>sshd,bruteforce,ccdc_high,</group>
  </rule>

  <rule id="102003" level="12">
    <if_sid>5715,40112</if_sid>
    <match type="pcre2">Accepted\s+.*\s+for\s+root\b</match>
    <description>SSH root login: $(srcip)</description>
    <mitre>
      <id>T1078.003</id>
      <id>T1021.004</id>
    </mitre>
    <group>sshd,authentication_success,ccdc_high,</group>
  </rule>

  <rule id="102004" level="10">
    <if_group>syslog</if_group>
    <match type="pcre2">Successful su for root</match>
    <description>su to root</description>
    <mitre>
      <id>T1548</id>
    </mitre>
    <group>privilege_escalation,ccdc_high,</group>
  </rule>

  <rule id="102005" level="7">
    <if_group>syslog|audit</if_group>
    <match type="pcre2">\b(apt|apt-get|yum|dnf|dpkg|rpm)\b.*(install|remove|purge|erase)</match>
    <description>Package install/remove</description>
    <group>package_management,ccdc_low,</group>
  </rule>

  <rule id="102006" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/etc/(passwd|shadow|group|sudoers|sudoers\.d/|ssh/sshd_config|cron)|/root/\.ssh/|/etc/systemd/system/)</field>
    <description>FIM auth/persist: $(syscheck.path)</description>
    <mitre>
      <id>T1098</id>
      <id>T1543.002</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102007" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/var/www/|/usr/share/(roundcube|nginx|httpd)/|/opt/.*/webapps/)</field>
    <description>FIM webroot: $(syscheck.path)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>syscheck,webshell,ccdc_high,</group>
  </rule>

  <rule id="102008" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <field name="audit.exe" type="pcre2" negate="yes">/usr/bin/mktemp$</field>
    <match type="pcre2">(exe="/(tmp|dev/shm|var/tmp)/|a[01]="/(tmp|dev/shm|var/tmp)/|memfd:|exe="[^"]*\(deleted\)")</match>
    <description>Temp/memfd exec: $(audit.exe)</description>
    <mitre>
      <id>T1059</id>
      <id>T1620</id>
    </mitre>
    <group>audit,execution,defense_evasion,ccdc_high,</group>
  </rule>

  <rule id="102009" level="11">
    <if_group>audit|syslog</if_group>
    <match type="pcre2">(?i)(/dev/tcp/|(\bsh|\bbash)\b.*(\s|")-i(\s|"|$)|\b(nc|ncat)\b.*(\s|")-e(\s|"|$)|\bsocat\b.*exec:|curl.*\|\s*(ba)?sh|wget.*\|\s*(ba)?sh)</match>
    <description>Reverse shell / piped payload</description>
    <mitre>
      <id>T1059.004</id>
      <id>T1105</id>
    </mitre>
    <group>execution,c2,ccdc_high,</group>
  </rule>

  <rule id="102010" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/etc/ld\.so\.preload|/etc/pam\.d/|/etc/profile\.d/|/home/.*/\.ssh/authorized_keys|/root/\.ssh/authorized_keys)</field>
    <description>FIM persistence: $(syscheck.path)</description>
    <mitre>
      <id>T1574.006</id>
      <id>T1556.003</id>
      <id>T1098.004</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102011" level="11">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^/etc/(postfix|dovecot|exim4|mysql|postgresql)/</field>
    <description>FIM mail/DB cfg: $(syscheck.path)</description>
    <mitre>
      <id>T1505</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102012" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^(shadow_read|suid_priv|ccdc_exec)$</field>
    <field name="audit.exe" type="pcre2" negate="yes">(unix_chkpwd|gdm-session-worker|polkit-agent-helper-1|accounts-daemon|chage|passwd|wazuh-modulesd|wazuh-syscheckd|sshd-session|stat|useradd|userdel)$</field>
    <match type="pcre2">(chmod\b.*(\s|")(\+s|u\+s|[2467][0-7]{3})(\s|")|setcap\b|find\b.*-perm.*-4000|/etc/shadow)</match>
    <description>SUID/shadow access</description>
    <mitre>
      <id>T1548.001</id>
      <id>T1003.008</id>
    </mitre>
    <group>audit,privilege_escalation,credential_access,ccdc_high,</group>
  </rule>

  <rule id="102013" level="7">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <field name="audit.cwd" type="pcre2" negate="yes">^/var/ossec$</field>
    <field name="audit.exe" type="pcre2" negate="yes">(wazuh-modulesd|wazuh-agentd|wazuh-syscheckd)$</field>
    <match type="pcre2">\b(whoami|uname\b.*-a|cat\b.*/etc/passwd|ss\b.*-|netstat\b.*-)</match>
    <description>Host discovery cmd</description>
    <mitre>
      <id>T1082</id>
      <id>T1033</id>
    </mitre>
    <group>audit,discovery,ccdc_low,</group>
  </rule>

  <rule id="102014" level="10">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">\b(mysqldump|pg_dump|7z\b.*a|tar\b.*-c)</match>
    <description>DB dump / archive staging</description>
    <mitre>
      <id>T1560</id>
      <id>T1005</id>
    </mitre>
    <group>audit,collection,ccdc_medium,</group>
  </rule>

  <rule id="102015" level="13">
    <if_group>audit</if_group>
    <field name="audit.comm" type="pcre2">^(sh|bash|dash|python[0-9.]*|perl|nc)$</field>
    <match type="pcre2">UID="(www-data|apache|nginx|http)"</match>
    <description>Web user shell: $(audit.comm)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>audit,webshell,ccdc_high,</group>
  </rule>

  <rule id="102016" level="10">
    <if_group>web|accesslog</if_group>
    <match type="pcre2">(?i)(union\s+select|\.\./\.\./|cmd=|eval\(|base64_decode)</match>
    <description>Web SQLi/LFI/webshell</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,ccdc_high,</group>
  </rule>

  <rule id="102017" level="4">
    <if_group>firewall|syslog</if_group>
    <match type="pcre2">(\[UFW BLOCK\]|FINAL_REJECT:|_DROP|_REJECT).*SRC=</match>
    <description>FW block $(srcip) -> :$(dstport)</description>
    <group>firewall,recon,</group>
  </rule>

  <rule id="102019" level="10" frequency="5" timeframe="30">
    <if_matched_sid>102017</if_matched_sid>
    <same_source_ip />
    <description>Port scan burst: $(srcip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,portscan,ccdc_medium,</group>
  </rule>

  <rule id="102018" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(?i)(python[0-9.]*\b.*(subprocess|pty\.spawn|socket|os\.system)|perl\b.*(socket|IO::Socket)|php\b.*(fsockopen|shell_exec|system\()|ruby\b.*TCPSocket|mkfifo\b.*/tmp/)</match>
    <description>Script revshell: $(audit.exe)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>audit,c2,execution,ccdc_high,</group>
  </rule>

  <rule id="102020" level="13">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/bin/|/sbin/|/usr/bin/|/usr/sbin/)</field>
    <description>FIM sys binary: $(syscheck.path)</description>
    <mitre>
      <id>T1036</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102021" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(systemctl\b.*(\s|")(stop|disable|mask)(\s|")|iptables\b.*(\s|")(-F|-P.*DROP|-A.*(DROP|REJECT))(\s|")|ufw\b.*(\s|")disable(\s|"))</match>
    <description>Service/FW tamper: $(audit.exe)</description>
    <mitre>
      <id>T1489</id>
      <id>T1562.004</id>
    </mitre>
    <group>audit,impact,defense_evasion,ccdc_high,</group>
  </rule>

  <rule id="102022" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(exe="/usr/bin/pkexec"|/(tmp|var|home|opt|etc)/\.[a-zA-Z0-9_-]+/)</match>
    <description>pkexec/hidden exec: $(audit.exe)</description>
    <mitre>
      <id>T1068</id>
      <id>T1564.001</id>
    </mitre>
    <group>audit,privilege_escalation,defense_evasion,ccdc_high,</group>
  </rule>

  <rule id="102023" level="6">
    <if_group>syslog|authentication_failed</if_group>
    <program_name type="pcre2">^(vsftpd|proftpd)$</program_name>
    <match type="pcre2">(FAIL LOGIN|Login failed|authentication failure|530 Login incorrect)</match>
    <description>FTP auth fail: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,ftp,ccdc_med,</group>
  </rule>

  <rule id="102024" level="10" frequency="5" timeframe="30">
    <if_matched_sid>102023</if_matched_sid>
    <same_source_ip />
    <description>FTP brute force: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,ftp,ccdc_high,</group>
  </rule>

  <rule id="102025" level="6">
    <if_group>syslog|authentication_failed</if_group>
    <program_name type="pcre2">^(dovecot|postfix|saslauthd)</program_name>
    <match type="pcre2">(auth failed|authentication failed|SASL .* authentication failed|Password mismatch)</match>
    <description>Mail auth fail: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,mail,ccdc_med,</group>
  </rule>

  <rule id="102026" level="10" frequency="5" timeframe="30">
    <if_matched_sid>102025</if_matched_sid>
    <same_source_ip />
    <description>Mail brute force: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,mail,ccdc_high,</group>
  </rule>

  <rule id="102027" level="6">
    <if_group>syslog|pam|authentication_failed</if_group>
    <program_name type="pcre2">^cockpit</program_name>
    <match type="pcre2">(authentication failure|Failed password|invalid user|Authentication failed)</match>
    <description>Cockpit auth fail: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,cockpit,ccdc_med,</group>
  </rule>

  <rule id="102028" level="10" frequency="5" timeframe="30">
    <if_matched_sid>102027</if_matched_sid>
    <same_source_ip />
    <description>Cockpit brute force: $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,cockpit,ccdc_high,</group>
  </rule>

  <rule id="102029" level="10">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/etc/aliases|/etc/postfix/virtual|/var/vmail/.*\.sieve|/home/[^/]+/\.forward)$</field>
    <description>FIM mail fwd/alias: $(syscheck.path)</description>
    <mitre>
      <id>T1114.003</id>
    </mitre>
    <group>syscheck,persistence,mail,ccdc_high,</group>
  </rule>

  <rule id="102030" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/root/\.bash(rc|_profile)|/root/\.profile|/home/[^/]+/(\.bash(rc|_profile)|\.profile|\.config/systemd/user/)|/var/spool/cron/)</field>
    <description>FIM user persist: $(syscheck.path)</description>
    <mitre>
      <id>T1546.004</id>
      <id>T1053.003</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

  <rule id="102031" level="13">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(?i)((truncate|shred)\b.*/var/log/|rm\b.*/var/log/(auth|secure|syslog|messages|audit)|auditctl\b.*-D|systemctl\b.*(stop|disable|mask).*(wazuh-agent|auditd))</match>
    <description>Log/agent tamper: $(audit.exe)</description>
    <mitre>
      <id>T1070.002</id>
      <id>T1070.003</id>
      <id>T1562.001</id>
    </mitre>
    <group>audit,defense_evasion,ccdc_high,</group>
  </rule>

  <rule id="102032" level="13">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <field name="audit.comm" type="pcre2">^(insmod|modprobe|kmod)$</field>
    <description>Kernel module load: $(audit.exe)</description>
    <mitre>
      <id>T1547.006</id>
    </mitre>
    <group>audit,persistence,rootkit,ccdc_high,</group>
  </rule>

  <rule id="102033" level="11">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(?i)((curl|wget)\b.*a[0-9]="[^"]*/(tmp|dev/shm)/|\bchisel\b|\bssh\b.*a[0-9]="-(R|L|D))</match>
    <description>Payload dl / tunnel: $(audit.exe)</description>
    <mitre>
      <id>T1105</id>
      <id>T1021.004</id>
      <id>T1572</id>
    </mitre>
    <group>audit,c2,lateral_movement,ccdc_high,</group>
  </rule>

  <rule id="102034" level="12">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <match type="pcre2">(?i)((strace|ltrace|gdb)\b.*(\s|")-p(\s|")|/dev/input/event|\blogkeys\b|pam_tty_audit)</match>
    <description>Keylogger / ptrace sniff: $(audit.exe)</description>
    <mitre>
      <id>T1056.001</id>
    </mitre>
    <group>audit,credential_access,ccdc_high,</group>
  </rule>

  <rule id="102035" level="10">
    <if_group>syslog</if_group>
    <match type="pcre2">entered promiscuous mode</match>
    <description>Promiscuous sniffer mode</description>
    <mitre>
      <id>T1040</id>
    </mitre>
    <group>network,credential_access,ccdc_high,</group>
  </rule>

  <rule id="102036" level="13">
    <if_group>rootcheck</if_group>
    <description>Rootcheck anomaly</description>
    <mitre>
      <id>T1014</id>
    </mitre>
    <group>rootcheck,rootkit,ccdc_high,</group>
  </rule>

  <rule id="102037" level="12" frequency="5" timeframe="60">
    <if_matched_sid>102016</if_matched_sid>
    <same_source_ip />
    <description>Web attack burst: $(srcip)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,ccdc_high,</group>
  </rule>

  <rule id="102038" level="11">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <field name="audit.comm" type="pcre2">^(passwd|chpasswd)$</field>
    <description>Password change/reset: $(audit.exe)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>audit,persistence,account_manipulation,ccdc_high,</group>
  </rule>

  <rule id="102039" level="13">
    <if_group>audit</if_group>
    <field name="audit.key" type="pcre2">^ccdc_exec$</field>
    <field name="audit.exe" type="pcre2">/(sh|bash|dash|python|perl|nc|ncat)$</field>
    <match type="pcre2">(postfix|dovecot|vsftpd|proftpd|splunkd)</match>
    <description>Mail/FTP/Splunk shell: $(audit.exe)</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>audit,execution,ccdc_high,</group>
  </rule>

  <rule id="102040" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path" type="pcre2">^(/opt/splunk/etc|/etc/postfix|/etc/dovecot)/</field>
    <description>Splunk/Mail config mod: $(syscheck.path)</description>
    <mitre>
      <id>T1543</id>
    </mitre>
    <group>syscheck,persistence,ccdc_high,</group>
  </rule>

</group>
