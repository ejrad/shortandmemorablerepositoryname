-a always,exit -F arch=b64 -S execve -k ccdc_exec
-a always,exit -F arch=b32 -S execve -k ccdc_exec
-w /etc/shadow -p rwa -k shadow_read
-w /etc/passwd -p wa -k ccdc_identity
-w /etc/sudoers -p wa -k ccdc_priv
-w /etc/sudoers.d/ -p wa -k ccdc_priv
-w /etc/ld.so.preload -p wa -k ccdc_persist
-w /etc/cron.d/ -p wa -k ccdc_persist
-w /etc/crontab -p wa -k ccdc_persist
-w /root/.ssh/ -p wa -k ccdc_persist
-w /etc/pam.d/ -p wa -k ccdc_persist
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F a1&04000 -k suid_priv
